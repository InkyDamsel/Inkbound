rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // Reader-owned application data. Each reader can only access their own tree.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Server-authoritative access records. Readers can inspect their own access,
    // but only trusted server code may create or modify entitlement documents.
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    // Admin membership is server-managed. An admin may read their own record;
    // enabled admins may read the directory for the admin panel.
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update, delete: if false;
    }

    // Minimal account directory used by the admin panel. Users may read their
    // own record, while enabled admins may search accounts. Writes are server-only.
    match /userDirectory/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    // Audit history is immutable from every browser client.
    match /adminAudit/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Deny anything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
