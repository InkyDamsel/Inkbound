# Copy this file to .env.local and replace the placeholder values.
# Never commit .env.local or production credentials.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# DEV / PRODUCTION FIREBASE MODE
# Normal `npm run dev` sessions default to the Firebase Local Emulator Suite even
# when this variable is omitted. That keeps routine development off production
# Firestore, Functions, Auth, and Storage and avoids Firebase usage charges.
#
# Leave this as emulator for normal work.
VITE_FIREBASE_MODE=emulator
#
# Only for an intentional live-cloud verification session:
# VITE_FIREBASE_MODE=production
#
# Production builds automatically use production Firebase regardless of this
# development setting.

# EXTRA PRODUCTION-WRITE SAFETY
# This matters only when running localhost with VITE_FIREBASE_MODE=production.
# Keep false unless you intentionally need browser-side writes against production.
VITE_ALLOW_PROD_FIREBASE_WRITES=false

# Restrict this key to the Google Books API and your approved web origins.
VITE_GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Public URL for the secure subscription-management portal supplied by your billing provider.
# Paid Premium members use this to update payment details, change plans, view invoices, or cancel.
VITE_BILLING_PORTAL_URL=https://your-secure-billing-portal.example.com
