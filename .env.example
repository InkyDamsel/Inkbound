# Copy this file to .env.local and replace the placeholder values.
# Never commit .env.local or production credentials.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# FIREBASE APP CHECK — WEB
# Register the Inkbound web app in Firebase App Check with reCAPTCHA Enterprise,
# then place the PUBLIC site key here. Android uses native Play Integrity through
# the Capacitor Firebase App Check adapter; it does not use this reCAPTCHA key.
VITE_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_enterprise_site_key

# DEV / PRODUCTION FIREBASE MODE
# Normal `npm run dev` sessions default to the Firebase Local Emulator Suite even
# when this variable is omitted. That keeps routine development off production
# Firestore, Functions, Auth, and Storage and avoids Firebase usage charges.
#
# Leave this as emulator for normal work.
VITE_FIREBASE_MODE=emulator
#
# Only for an intentional live-cloud verification session:
# VITE_FIREBASE_MODE=production
#
# Production builds automatically use production Firebase regardless of this
# development setting.

# EXTRA PRODUCTION-WRITE SAFETY
# This matters only when running localhost with VITE_FIREBASE_MODE=production.
# Keep false unless you intentionally need browser-side writes against production.
VITE_ALLOW_PROD_FIREBASE_WRITES=false

# GOOGLE BOOKS — WEB ONLY
# Restrict this browser key to the Google Books API and approved web origins.
# `npm run build:android` forcibly removes this value from the native bundle.
# Android Google Books traffic uses the server-side GOOGLE_BOOKS_API_KEY Firebase
# Functions secret configured with `npm run firebase:secret:google-books`.
VITE_GOOGLE_BOOKS_API_KEY=your_google_books_web_api_key

# WEB BILLING ONLY
# Native Android builds intentionally refuse to open this portal. Google Play
# subscriptions will use the Play Billing adapter and feed the canonical Inkbound
# entitlement service instead.
VITE_BILLING_PORTAL_URL=https://your-secure-billing-portal.example.com
