{
  "name": "Inkbound — Reading & Library Tracker by Inky Dame Interactive",
  "short_name": "Inkbound",
  "description": "Inkbound is a reading and library tracker by Inky Dame Interactive for personal libraries, reading progress, sessions, collections, goals, imports, memories, and reading insights.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#120817",
  "theme_color": "#120817",
  "categories": ["books", "lifestyle", "productivity"],
  "icons": [
    {
      "src": "/assets/branding/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/branding/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/branding/pwa/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
